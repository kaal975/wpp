# Wind speed and power over time
plt.figure(figsize=(10, 4))
plt.plot(df['timestamp'], df['speed_mps'], label='Speed (m/s)')
plt.plot(df['timestamp'], df['speed_smooth'], label='Smoothed', lw=2)
plt.xlabel('Time'); plt.ylabel('Wind Speed (m/s)'); plt.legend(); plt.title('Wind Speed Time Series')
plt.show()


plt.figure(figsize=(10, 4))
plt.plot(df['timestamp'], df['power_kw'], color='orange')
plt.xlabel('Time'); plt.ylabel('Power (kW)'); plt.title('Generated Power Over Time')
plt.show()

# Wind Rose (Speed-weighted Polar Plot)


bins = 16
angles = np.linspace(0, 2*np.pi, bins+1)
counts = np.zeros(bins)


for i in range(bins):
  mask = (np.deg2rad(df['direction_deg']) >= angles[i]) & (np.deg2rad(df['direction_deg']) < angles[i+1])
counts[i] = df['speed_mps'][mask].sum()


ax = plt.subplot(111, polar=True)
ax.bar(angles[:-1], counts, width=(2*np.pi)/bins, color='skyblue', edgecolor='k')
ax.set_title('Wind Rose (Speed-Weighted)', va='bottom')
plt.show()

# Power vs. Speed Scatter Plot


plt.figure(figsize=(6, 5))
plt.scatter(df['speed_mps'], df['power_kw'], c=df['regime'], cmap='viridis', alpha=0.7)
plt.xlabel('Wind Speed (m/s)')
plt.ylabel('Power (kW)')
plt.title('Power Curve with Regime Clusters')
plt.colorbar(label='Regime')
plt.show()
import os

