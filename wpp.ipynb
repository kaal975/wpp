import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from datetime import datetime, timedelta
from scipy.signal import savgol_filter
from sklearn.cluster import KMeans
from math import atan2
import os


# -------------------------------
# 1. Simulate Wind Data
# -------------------------------


def generate_wind_series(start, hours=168, freq_minutes=10, seed=42):
  np.random.seed(seed)
  periods = int(hours * 60 / freq_minutes)
  timestamps = [start + timedelta(minutes=i*freq_minutes) for i in range(periods)]


  # Base daily variation + noise
  minutes = np.arange(periods) * freq_minutes
  daily = 3 + 2.5 * np.sin(2 * np.pi * minutes / (24*60))
  noise = np.random.normal(scale=0.8, size=periods)
  speed = np.clip(daily + noise, 0, None)


  # Add gust spikes
  for _ in range(int(0.02 * periods)):
    idx = np.random.randint(0, periods)
    speed[idx: idx+3] += np.random.uniform(4, 10)


  # Wind direction variation
  dir_base = 180 + 30 * np.sin(2 * np.pi * minutes / (3*24*60))
  dir_noise = np.random.vonmises(mu=0, kappa=4, size=periods) * (180/np.pi)
  direction = (dir_base + dir_noise) % 360


  # RPM proportional to speed
  rpm = np.clip(10 * (speed - 3), 0, 200)


  # Simplified power model (kW)
  rho = 1.225; area = 10.0; cp = 0.35
  power = 0.5 * rho * area * cp * np.power(speed, 3) * 0.001
  power += np.random.normal(scale=0.05, size=periods)
  power = np.clip(power, 0, None)


  df = pd.DataFrame({
  'timestamp': timestamps,
  'speed_mps': speed,
  'direction_deg': direction,
  'rpm': rpm,
  'power_kw': power
  })

  return df


# Generate 1 week of sample data
df = generate_wind_series(datetime.now() - timedelta(hours=168))
display(df.head())
# ----------------------------------
# 2. Analyze Wind Data
# ----------------------------------


def circular_mean_deg(angles_deg):
  a = np.deg2rad(angles_deg)
  s, c = np.mean(np.sin(a)), np.mean(np.cos(a))
  mean = np.rad2deg(atan2(s, c))
  return mean if mean >= 0 else mean + 360


# Smooth the speed data
df['speed_smooth'] = savgol_filter(df['speed_mps'], window_length=11, polyorder=2)


# Gust detection
df['is_gust'] = df['speed_mps'] > (df['speed_smooth'] + 3.0)


# Rolling circular mean of direction
window = 12
circ_means = []
for i in range(len(df)):
  start = max(0, i-window+1)
  circ_means.append(circular_mean_deg(df['direction_deg'].values[start:i+1]))

df['direction_circ_mean'] = circ_means


# Cluster wind regimes
X = np.column_stack([df['speed_smooth'], np.cos(np.deg2rad(df['direction_deg'])), np.sin(np.deg2rad(df['direction_deg']))])
model = KMeans(n_clusters=3, random_state=0).fit(X)
df['regime'] = model.labels_


# Regime summary
summary = df.groupby('regime').agg(
mean_speed=('speed_mps', 'mean'),
dominant_direction=('direction_deg', lambda x: circular_mean_deg(x.values)),
gust_count=('is_gust', 'sum'),
samples=('timestamp', 'count')
).reset_index()
# ----------------------------------
# 3. Visualize Results
# ----------------------------------


# Wind speed and power over time
plt.figure(figsize=(10, 4))
plt.plot(df['timestamp'], df['speed_mps'], label='Speed (m/s)')
plt.plot(df['timestamp'], df['speed_smooth'], label='Smoothed', lw=2)
plt.xlabel('Time'); plt.ylabel('Wind Speed (m/s)'); plt.legend(); plt.title('Wind Speed Time Series')
plt.show()


plt.figure(figsize=(10, 4))
plt.plot(df['timestamp'], df['power_kw'], color='orange')
plt.xlabel('Time'); plt.ylabel('Power (kW)'); plt.title('Generated Power Over Time')
plt.show()

